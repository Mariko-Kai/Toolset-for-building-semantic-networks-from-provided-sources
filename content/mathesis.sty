\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mathesis}[2026/02/19 Semantic entity cross-references and macros]

% --- Dependencies ---
\RequirePackage{amsmath, amssymb, mathtools, amsthm}
\RequirePackage{xcolor}
\RequirePackage[hidelinks]{hyperref}

% Custom theorem style: breaks the line after the header so formulas start fresh
\newtheoremstyle{mathesisstyle}%
  {6pt}   % space above
  {6pt}   % space below
  {}      % body font (normal, not italic)
  {}      % indent amount
  {\bfseries} % theorem head font
  {.}     % punctuation after theorem head
  {\newline} % space after theorem head — \newline forces a line break!
  {\thmname{#1}\thmnumber{ #2}\thmnote{ (#3)}\leavevmode} % theorem head spec

\theoremstyle{mathesisstyle}
\newtheorem{object}{Объект}[chapter]
\newtheorem{operation}{Операция}[chapter]
\newtheorem{property}{Свойство}[chapter]
\newtheorem{axiom}{Аксиома}[chapter]
\newtheorem{theorem}{Теорема}[chapter]
\newtheorem{lemma}{Лемма}[chapter]
\newtheorem{corollary}{Следствие}[chapter]

% --- Semantic Entity Reference (for backward compatibility) ---
\newcommand{\entityref}[2]{\hyperlink{#1}{#2}}

% --- All Semantic Macros (including auto-generated) ---
\RequirePackage{mathesis_macros}

\newcommand{\mReal}{\mathbb{R}}
\newcommand{\mNat}{\mathbb{N}}
\newcommand{\mZ}{\mathbb{Z}}


% --- Redefining paired macros to hyperlink brackets properly ---
\renewcommand{\AbsAbstract}[1]{\mathopen{\hyperlink{def-abs-abstract}{\left\lvert\vphantom{#1}\right.}}#1\mathclose{\hyperlink{def-abs-abstract}{\left.\vphantom{#1}\right\rvert}}}
\renewcommand{\RealAbsoluteValue}[1]{\mathopen{\hyperlink{def-real-absolute-value}{\left\lvert\vphantom{#1}\right.}}#1\mathclose{\hyperlink{def-real-absolute-value}{\left.\vphantom{#1}\right\rvert}}}
\renewcommand{\ClosedInterval}[1]{\mathopen{\hyperlink{def-closed-interval}{\left[\vphantom{#1}\right.}}#1\mathclose{\hyperlink{def-closed-interval}{\left.\vphantom{#1}\right]}}}
\renewcommand{\OpenInterval}[1]{\mathopen{\hyperlink{def-open-interval}{\left(\vphantom{#1}\right.}}#1\mathclose{\hyperlink{def-open-interval}{\left.\vphantom{#1}\right)}}}
\newcommand{\SetBuilder}[1]{\mathopen{\hyperlink{axiom-set}{\left\{\vphantom{#1}\right.}}#1\mathclose{\hyperlink{axiom-set}{\left.\vphantom{#1}\right\}}}}
