# Mathesis — переменные окружения (скопируйте в .env и заполните).
# .env загружается автоматически в pipeline.config (с фолбэком без python-dotenv);
# существующие переменные окружения имеют приоритет и не перезаписываются.
#
#   cp .env.example .env   # затем впишите свои ключи

# --- Ключи провайдеров (по умолчанию для соответствующих провайдеров) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Ollama (локальный/удалённый) ---
# Хост Ollama, если не localhost:11434 (напр. http://192.168.1.10:11434)
# MATHESIS_OLLAMA_HOST=

# --- Необязательные настройки рантайма ---
# Путь к канонической БД (по умолчанию db/mathesis_index.db)
# MATHESIS_DB_PATH=
# Таймаут сетевых вызовов, сек (по умолчанию 60)
# MATHESIS_HTTP_TIMEOUT=60
# Число повторов вызова модели (по умолчанию 2)
# MATHESIS_MODEL_RETRIES=2
# Таймаут одной Lean-валидации, сек (по умолчанию 300; холодный старт грузит Mathlib)
# MATHESIS_LEAN_TIMEOUT=300
# Прогонять обогащение через оркестратор (мониторинг+персистенция): 1 — включить
# MATHESIS_ORCHESTRATED=0
