# Mathesis — Шаблон переменных окружения (скопируйте в .env и заполните).
# .env загружается автоматически в pipeline.config на старте приложения.
# Существующие переменные окружения в системе имеют более высокий приоритет.
#
#   cp .env.example .env   # Создайте локальную копию .env

# ===========================================================================
# 1. API КЛЮЧИ ПРОВАЙДЕРОВ (глобальные по умолчанию для провайдеров)
# ===========================================================================
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ===========================================================================
# 2. ГЛОБАЛЬНЫЕ МОДЕЛИ ПО УМОЛЧАНИЮ ДЛЯ КАЖДОГО ПРОВАЙДЕРА
# ===========================================================================
# Будут использованы, если модуль использует соответствующий провайдер
# MATHESIS_OLLAMA_MODEL=deepseek-r1:7b
# MATHESIS_GEMINI_MODEL=gemini-3.1-flash-lite
# MATHESIS_OPENAI_MODEL=gpt-4o-mini
# MATHESIS_GROQ_MODEL=llama-3.3-70b-versatile
# MATHESIS_HF_MODEL=Qwen/Qwen2.5-Coder-Artifacts
# MATHESIS_LLAMA_CPP_MODEL=bge-reranker-v2-m3-Q6_K.gguf

# Хост Ollama, если не localhost:11434 (например, http://192.168.1.10:11434)
# MATHESIS_OLLAMA_HOST=

# ===========================================================================
# 3. МОДУЛЬНЫЕ НАСТРОЙКИ (Переопределяют глобальные настройки для конкретной роли)
# ===========================================================================
# Допустимые провайдеры: ollama, gemini, openai, groq, hf, llama_cpp
#
# --- Извлечение сущностей (extract) ---
# MATHESIS_EXTRACT_PROVIDER=ollama
# MATHESIS_EXTRACT_MODEL=qwen3:8b
# MATHESIS_EXTRACT_API_KEY=
#
# --- Синтез математического текста (synth) ---
# MATHESIS_SYNTH_PROVIDER=ollama
# MATHESIS_SYNTH_MODEL=deepseek-r1:7b
# MATHESIS_SYNTH_API_KEY=
#
# --- Валидатор и генератор Lean-кода (lean) ---
# MATHESIS_LEAN_PROVIDER=ollama
# MATHESIS_LEAN_MODEL=goedel:latest
# MATHESIS_LEAN_API_KEY=
#
# --- Генерация эмбеддингов текстов (embed) ---
# MATHESIS_EMBED_PROVIDER=ollama
# MATHESIS_EMBED_MODEL=nomic-embed-text:latest
# MATHESIS_EMBED_API_KEY=
#
# --- Предпросмотр и реранкер (preview) ---
# MATHESIS_PREVIEW_PROVIDER=llama_cpp
# MATHESIS_PREVIEW_MODEL=bge-reranker-v2-m3-Q6_K.gguf
# MATHESIS_PREVIEW_API_KEY=

# ===========================================================================
# 4. РЕРАНКЕР И НАСТРОЙКИ LLAMA.CPP
# ===========================================================================
# Если уже запущен llama.cpp rerank-сервер — укажите его URL (используется как REST API):
# MATHESIS_RERANK_URL=http://localhost:8080
# Порт для АВТО-запуска llama.cpp сервера с GGUF-реранкером (по умолчанию 8080):
# MATHESIS_RERANK_PORT=8080
# Каталог, где лежит GGUF-реранкер (если модель задана только именем файла):
# MATHESIS_LLAMA_DIR=F:/Universe/Projects/Учебник по матанализу/llama

# ===========================================================================
# 5. НАСТРОЙКИ ОКРУЖЕНИЯ И РАНТАЙМА (НЕОБЯЗАТЕЛЬНЫЕ)
# ===========================================================================
# Путь к канонической базе данных SQLite (по умолчанию db/mathesis_index.db)
# MATHESIS_DB_PATH=
# Максимальный таймаут ожидания для всех внешних процессов (pdflatex, Lean и т.д.), сек
# MATHESIS_SUBPROCESS_TIMEOUT=900
# Таймаут сетевых HTTP-вызовов к провайдерам, сек (по умолчанию 60)
# MATHESIS_HTTP_TIMEOUT=60
# Число повторов вызова LLM-модели при сетевых сбоях (по умолчанию 2)
# MATHESIS_MODEL_RETRIES=2
# Таймаут одной Lean-валидации, сек (по умолчанию 300)
# MATHESIS_LEAN_TIMEOUT=300
# Включить оркестратор прогона (мониторинг + история прогонов + инциденты): 1 — да, 0 — нет
# MATHESIS_ORCHESTRATED=0
