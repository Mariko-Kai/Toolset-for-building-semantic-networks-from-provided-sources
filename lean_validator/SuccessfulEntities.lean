def IsLeftLimit (f : ℝ → ℝ) (x₀ : ℝ) (L : ℝ) : Prop :=
  ∀ ε > 0, ∃ δ > 0, ∀ x, x₀ - δ < x ∧ x < x₀ → |f x - L| < ε

