  ∀ ε > 0, ∃ δ > 0, ∀ x, 0 < |x - a| ∧ |x - a| < δ → |f x - L| < ε

theorem def_function_limit_at_point : 
  ∀ (f : ℝ → ℝ) (a : ℝ), 
  (∃ L, HasLimitAt f a L) → 
  ∃ L, HasLimitAt f a L := by sorry

